%% Diagramme des flux et zones de données ReviewPulse
flowchart TB
    subgraph RAW["Zone brute (raw)"]
        RAW_DATA["raw/<br/>JSONL<br/>immuable"]
        RAW_MANIFEST["Manifeste d’idempotence"]
    end

    subgraph CLEAN["Zone propre (clean)"]
        CLEAN_DATA["clean/<br/>Parquet<br/>pseudonymisé"]
        SILVER_TABLE["Iceberg silver.reviews<br/>instantanés"]
    end

    subgraph SCORED["Zone scorée (scored)"]
        SCORED_DATA["scored/<br/>Parquet"]
        DAILY_SUM["daily_summary.parquet"]
        PRED_TABLE["Iceberg silver.predictions"]
    end

    subgraph GOLD["Zone gold (gold)"]
        GOLD_TABLES["DuckDB<br/>main.fct_review_predictions<br/>main.mart_sentiment_daily"]
    end

    subgraph MODULES["Modules"]
        INGEST["ingest.py"]
        SPARK["spark_silver.py"]
        GX["expectations.py"]
        SCORE["score.py"]
        DRIFT["drift.py"]
        DBT["gold.py (dbt‑duckdb)"]
    end

    %% Flux de données
    API["API avis Steam"] --> INGEST
    INGEST --> RAW_DATA
    INGEST --> RAW_MANIFEST
    RAW_DATA --> SPARK
    SPARK --> CLEAN_DATA
    SPARK --> SILVER_TABLE
    CLEAN_DATA --> GX
    GX -->|qualité bloquante| SCORE
    SCORE --> SCORED_DATA
    SCORE --> DAILY_SUM
    SCORE --> PRED_TABLE
    SILVER_TABLE --> DBT
    PRED_TABLE --> DBT
    DBT --> GOLD_TABLES
    SCORED_DATA --> DRIFT
    DAILY_SUM --> DRIFT
    DRIFT --> DRIFT_OUT["drift_report.json<br/>et alertes datées"]

    classDef zone fill:#f9f9f9,stroke:#333,stroke-width:1px;
    classDef module fill:#e8f5e9,stroke:#2e7d32;
    classDef gate fill:#ffeb3b,stroke:#f57f17;
    class RAW,CLEAN,SCORED,GOLD zone;
    class INGEST,SPARK,GX,SCORE,DRIFT,DBT module;
    class GX gate;
