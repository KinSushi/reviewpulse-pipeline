flowchart TB
  subgraph CHAINE["Chaîne commune, indépendante du modèle"]
    direction LR
    ING["ingestion idempotente<br/>zone brute immuable"]
    SPARK["PySpark et Iceberg<br/>instantanés et restauration"]
    QUAL["Great Expectations<br/>porte bloquante"]
    DBT["dbt et DuckDB<br/>contrats et tests"]
    REG["MLflow<br/>barrière, alias, retour arrière"]
    SERV["API, tableau de bord<br/>explicabilité"]
    OPS["Airflow, CI/CD<br/>dérive, alerte, réentraînement"]
    ING --> SPARK --> QUAL --> DBT --> REG --> SERV --> OPS
  end

  MOD["modèle interchangeable<br/>aujourd'hui TF-IDF et régression logistique"]
  MOD --> REG

  subgraph SERVIS["Blocs servis"]
    direction LR
    AIA4["AIA 4 — support déclaré<br/>tout le dépôt"]
    CDSD4["CDSD 4 — brique majeure<br/>analyse de sentiment"]
    CDSD5["CDSD 5 — brique majeure<br/>Docker, MLflow, API, URL publique"]
    AIA3["AIA 3 — brique<br/>DAG, qualité, traçabilité"]
    AIA2["AIA 2 — brique<br/>compose, zonage, secrets"]
    AIA1["AIA 1 — brique<br/>RGPD, AI Act, RACI"]
    CDSD1["CDSD 1 — brique<br/>collecte API, Spark"]
    CDSD2["CDSD 2 — brique<br/>même domaine Steam"]
  end

  CHAINE --> SERVIS

  subgraph MANQUE["Briques manquantes, registre R17"]
    direction LR
    X1["stockage objet S3 ou MinIO"]
    X2["Kafka, Avro, DLQ"]
    X3["Terraform"]
    X4["déploiement public"]
  end

  MANQUE -.->|bloque| SERVIS

  NON["CDSD 3 et CDSD 6<br/>déjà produits ailleurs, non servis"]
