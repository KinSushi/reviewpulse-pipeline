%% titre du diagramme
flowchart LR
    %% CI/CD pipeline
    A["push / PR"]:::ci --> B["workflow CI"]:::ci
    B --> C["checkout<br/>Python 3.11<br/>ruff<br/>pytest"]:::ci
    C --> D["fusion sur main"]:::ci
    D --> E["build Docker image"]:::ci
    E --> F["déploiement<br/>docker compose:<br/>mlflow, api, dashboard"]:::ci

    %% Scheduled pipeline
    G["cron 6h30 UTC"]:::sched --> H["déclenchement manuel"]:::sched
    G --> I["secret REVIEWPULSE_SALT"]:::sched
    H --> I
    I --> J["ingest"]:::sched
    J --> K["transform"]:::sched
    K --> L["train"]:::sched
    L --> M["score"]:::sched
    M --> N["artefact data/scored"]:::sched
    N --> O["résumé du run"]:::sched

    classDef ci fill:#e0f7fa,stroke:#006064;
    classDef sched fill:#fff3e0,stroke:#bf360c;
