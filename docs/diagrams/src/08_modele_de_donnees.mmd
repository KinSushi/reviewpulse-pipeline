%% Diagramme ER ReviewPulse
erDiagram
    REVIEW_CLEAN {
        string review_id PK
        int64 app_id
        string language
        string review_text
        int64 label
        datetime created_at
        datetime updated_at
        int64 votes_up
        float64 weighted_vote_score
        int64 playtime_at_review_min
        string author_pseudo
        int64 text_len
    }
    REVIEW_SCORED {
        string review_id FK
        float64 proba_negative
        int64 pred_label
        string model_version
        datetime scored_at
    }
    DAILY_SUMMARY {
        int64 app_id
        string language
        date date
        int64 n_reviews
        float64 share_negative_pred
        float64 share_negative_true
        string model_version
    }
    MODEL_VERSION {
        string model_name
        string version
        string alias
        string run_id
        float64 f1_macro
    }
    REVIEW_CLEAN ||--|| REVIEW_SCORED : "1:1"
    REVIEW_SCORED }|..|| MODEL_VERSION : "N:1"
    DAILY_SUMMARY }o..|| REVIEW_SCORED : "agrège"
