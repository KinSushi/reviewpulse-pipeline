%% Diagramme des DAG Airflow ReviewPulse
flowchart LR
  subgraph daily["DAG quotidien"]
    I[ingest] --> SP[spark_silver] --> GX[gx_validate] --> SCd["score (daily)"] --> DR[drift] --> Gd_daily["gold (daily)"]
    DR --> DE[derive_exige_reentrainement] --> TR[declencher_reentrainement]
  end

  subgraph weekly["DAG hebdomadaire"]
    TRN[train] --> SCw["score (weekly)"] --> Gd_weekly["gold (weekly)"]
  end

  TR -->|trigger| weekly

  classDef dag fill:#f9f9f9,stroke:#333,stroke-width:2px;
  class daily,weekly dag
