%% Cycle MLOps ReviewPulse
flowchart LR
    D1["données<br/>propres"]
    T1["entrainement<br/>TF-IDF + régression<br/>logistique"]
    M1["journalisation<br/>MLflow"]
    B1["barrière de promotion<br/>F1 macro ≥ 0,75<br/>et meilleur que champion"]
    CH["alias champion"]
    C1["alias challenger<br/>non servi"]
    S1["service API<br/>score quotidien"]
    MON["monitoring dérive<br/>données & prédictions"]
    A1["alerte dérive"]
    RE["déclenchement<br/>réentraînement<br/>hebdomadaire"]
    ROL["rollback.py<br/>rebasculer alias champion"]

    D1 --> T1 --> M1 --> B1
    B1 -->|pass| CH
    B1 -->|fail| C1
    CH --> S1
    S1 --> MON --> A1 --> RE --> D1
    ROL -.-> CH

    classDef data fill:#f0f0f0,stroke:#333;
    classDef model fill:#e6f7ff,stroke:#006;
    classDef mlflow fill:#fff3cd,stroke:#856404;
    classDef service fill:#d1ecf1,stroke:#0c5460;
    classDef monitor fill:#d4edda,stroke:#155724;

    class D1,T1 data
    class B1 model
    class M1 mlflow
    class CH,S1 service
    class MON,RE monitor
